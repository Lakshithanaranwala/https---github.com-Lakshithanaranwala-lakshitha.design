    "onboarding": {
      "title": "Designing LSE CRM around Real Users",
      "badge": "CRM",
      "typography": {
        "paragraphSize": 16,
        "problemParagraphSize": 36
      },
      "heroImage": "https://raw.githubusercontent.com/Lakshithanaranwala/https---github.com-Lakshithanaranwala-lakshitha.design/main/assets/case%20study%20images/LSE-png.jpg",
      "displayImage": "https://raw.githubusercontent.com/Lakshithanaranwala/https---github.com-Lakshithanaranwala-lakshitha.design/main/assets/case%20study%20images/DP-png.jpg",
      "overview": {
        "text": "Lasenda, an accounting service company, faced major operational inefficiencies due to limitations of their existing CRM, Hawksoft. The system lacked essential <b>task-tracking capabilities</b>, making it difficult to <b>monitor employee progress</b> and <b>manage workloads. </b>Weak data encryption posed <b>security concerns for sensitive financial information.</b> additionally, Hawksoft provided no reliable method for <b>handling client deadlines</b>, increasing the risk of delays and compliance issues.&nbsp;",
        "role": "UX + UI DESIGN",
        "tools": "FIGJAM, FIGMA",
        "duration": "3 Months | Agile"
      },
      "problem": "<p>\"Outdated CRM causes major<b><font color=\"#d31212\"> inefficiency</font></b>, <b><font color=\"#fc0303\">security risks</font></b>, and <b><font color=\"#d73737\">missed deadline</font><font color=\"#932525\">s</font></b><font color=\"#ff0000\">.</font><font color=\"#4c3d3d\">\"</font></p>",
      "goal": {
        "title": "Transforming workflow through secure, tailored software.",
        "text": "<div><ul><li>Develop a secure, centralized system tailored to Lasenda's workflow.</li><li>Enable clear tracking of employee tasks, workloads and project progress.</li><li>Implement stronger data protection and encryption measures for financial information.</li><li>introduced automated, reliable client-deadline management to reduce missed submission.</li><li>Create a flexible develipment process that adapts to evolving stakeholder needs.</li></ul></div>"
      },
      "process": {
        "discover": {
          "text": "To gain a deep understanding of Lasenda's operational challenges and user needs, a <b>5 day interview based research phase</b> was conducted with key stakeholders and end users. These sessions focused on uncovering daily workflows, <b>identifying pain points</b> within the existing Hawksoft system, and understanding unmet requirements related to task management, data security and deadline handling. Insights gathered from these interviews directly informed the product requirements and helped prioritized features that would deliver the greatest impact in the LSE system.",
          "images": [
